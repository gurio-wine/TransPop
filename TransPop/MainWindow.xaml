<Window x:Class="TransPop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TransPop · 翻译气泡｜自动候选检测" Width="640" Height="535"
        MinWidth="550" MinHeight="460" WindowStartupLocation="CenterScreen"
        Background="#F6F8FC" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#E4EEFF" />
            <Setter Property="Foreground" Value="#234674" />
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Border Background="#2563EB" CornerRadius="15" Width="48" Height="48" Margin="0,0,12,0">
                    <TextBlock Text="译" Foreground="White" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="TransPop" FontSize="24" FontWeight="Bold" Foreground="#1E293B" />
                    <TextBlock Text="翻译气泡 · Windows 10/11 · 自动候选读取 v0.5" FontSize="12" Foreground="#64748B" />
                </StackPanel>
            </StackPanel>
            <TextBlock Margin="0,14,0,0" Foreground="#475569" TextWrapping="Wrap"
                       Text="正常使用微软拼音即可。程序会优先查找 Windows.UI.Core.CoreWindow，自动定位候选框、读取第一个中文候选，并显示跟随气泡；不需要移动鼠标，也不会修改或提交输入内容。" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,18,0,0" Padding="17" CornerRadius="17"
                Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="自动检测正在启动…" FontSize="13"
                           FontWeight="SemiBold" Foreground="#475569" TextWrapping="Wrap" />
                <TextBlock x:Name="CandidateText" Margin="0,12,0,0" Text="第一候选：等待输入"
                           FontSize="21" FontWeight="SemiBold" Foreground="#2563EB"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LastSeenText" Margin="0,9,0,0" FontSize="12"
                           Foreground="#047857" Text="最近检测到：—" TextWrapping="Wrap" />
                <TextBlock x:Name="BoundsText" Margin="0,5,0,0" Foreground="#64748B"
                           FontSize="11" Text="坐标：—" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,17,0,0">
            <WrapPanel>
                <Button x:Name="PauseButton" Width="106" Background="#2563EB" Foreground="White"
                        Content="暂停检测" Click="PauseButton_Click" />
                <Button Width="100" Content="复制诊断" Click="CopyReportButton_Click" />
            </WrapPanel>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#64748B" FontSize="12"
                       Text="测试方法：运行程序后切到记事本，使用微软拼音输入 nihao，不要按空格。无需鼠标指向候选词。" />
        </StackPanel>
        <Border Grid.Row="3" Margin="0,15,0,0" Padding="12" CornerRadius="14"
                Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="自动检测状态 / 故障诊断" FontWeight="SemiBold" Foreground="#23334F" />
                <TextBox Grid.Row="1" x:Name="ReportBox" Margin="0,8,0,0"
                         Text="程序启动后会更新这里的检测记录。" Background="#F8FAFC"
                         FontFamily="Consolas" FontSize="11" Foreground="#334155"
                         BorderBrush="#E2E8F0" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                         AcceptsReturn="True" Padding="10" />
            </Grid>
        </Border>
        <TextBlock Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="#64748B" Text="测试版目前只显示中文候选用于验证读取；Bing / AI 翻译尚未接入。不截图、不录键、不联网。分享诊断前请检查候选文字。" />
    </Grid>
</Window>
