<Window x:Class="PinyinCandidateProbe.CandidateOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        Width="350" Height="80" FontFamily="Microsoft YaHei UI">
    <Border Background="#FDFEFF" BorderBrush="#93C5FD" BorderThickness="1"
            CornerRadius="10" Padding="13,9">
        <Border.Effect>
            <DropShadowEffect Color="#1E293B" BlurRadius="13" Opacity="0.16" ShadowDepth="3"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="微软拼音 · 第一候选（检测模式）" Foreground="#64748B" FontSize="11"/>
            <TextBlock x:Name="CandidateLabel" Foreground="#1D4ED8"
                       FontWeight="SemiBold" FontSize="17" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>
</Window>
